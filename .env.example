# Backend API root, no trailing slash. Leave empty to run against the in-browser mock backend.
VITE_API_BASE_URL=http://localhost:8000/api
# Shown on payment problems and refunds.
VITE_SUPPORT_CONTACT=support@hostme.co.ke
# true runs the in-browser mock backend even when VITE_API_BASE_URL is set.
VITE_USE_MOCKS=false
